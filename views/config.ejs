<h1 data-i18n="config_title">Configuration</h1>

<% if (fromSetup) { %>
<div class="alert alert-info" style="margin-bottom:1.25rem;">
  🎉 <strong data-i18n="config_setup_welcome_title">Almost done!</strong>
  <span data-i18n="config_setup_welcome_desc">Add your podcasts and tweak the music settings below, then hit Save.</span>
</div>
<% } %>

<% if (flash) { %>
<div class="alert alert-<%= flash.type %>" style="margin-bottom:1rem">
  <div><%= flash.message %></div>
  <% if (flash.message && (flash.message.includes('EACCES') || flash.message.includes('permission denied'))) { %>
  <div style="margin-top:0.75rem;padding-top:0.75rem;border-top:1px solid rgba(255,255,255,0.15);font-size:0.85rem;line-height:1.5">
    <strong style="display:block;margin-bottom:0.35rem" data-i18n="eacces_help_title">📁 Berechtigungsproblem auf der Synology NAS beheben:</strong>
    <ol style="margin:0;padding-left:1.25rem">
      <li data-i18n="eacces_help_step1">Öffne die <strong>File Station</strong> im Synology DSM.</li>
      <li data-i18n="eacces_help_step2">Navigiere zum gemounteten Ordner (z. B. <code>docker/dailydrive/data</code>).</li>
      <li data-i18n="eacces_help_step3">Rechtsklick auf den Ordner <code>data</code> → <strong>Eigenschaften</strong> → Reiter <strong>Berechtigung</strong>.</li>
      <li data-i18n="eacces_help_step4">Stelle sicher, dass <strong>Everyone / Jeder</strong> Lese- und Schreibrechte besitzt (inkl. Haken bei <em>"Auf diesen Ordner, Unterordner und Dateien anwenden"</em>).</li>
    </ol>
  </div>
  <% } %>
</div>
<% } %>

<% if (saved) { %>
<div class="alert alert-success" data-i18n="config_saved">Saved!</div>
<% } %>

<form action="/config" method="POST" id="config-form">

  <!-- ===== API-Modus ===== -->
  <div class="card">
    <div class="card-title">API-Modus</div>

    <div class="form-group">
      <label>Backend</label>
      <select name="api_mode" onchange="onApiModeChange(this.value)">
        <option value="oauth" <%= (config.api_mode || 'oauth') !== 'cookie' ? 'selected' : '' %>>OAuth (Empfohlen)</option>
        <option value="cookie" <%= config.api_mode === 'cookie' ? 'selected' : '' %>>Spotify Account (Cookie)</option>
      </select>
      <p class="field-hint">Wechsel erfordert erneutes Verbinden im Setup-Wizard.</p>
    </div>

    <!-- Cookie-Modus Credentials -->
    <div id="cookie-credentials" style="display:<%= config.api_mode === 'cookie' ? 'block' : 'none' %>">
      <div class="form-group">
        <label>sp_dc Cookie</label>
        <input type="password" name="spotify[sp_dc]" autocomplete="off"
          value="<%= config.spotify && config.spotify.sp_dc ? '••••••••' : '' %>"
          placeholder="AQB3...langer Cookie-Wert...">
        <p class="field-hint">
          Aus Browser-DevTools: <strong>F12 → Application → Cookies → open.spotify.com → sp_dc</strong>.
          Leer lassen um bestehenden Cookie beizubehalten.
        </p>
      </div>
    </div>

    <!-- Cookie-Modus Test-Button -->
    <div id="cookie-test-panel-config" style="display:<%= config.api_mode === 'cookie' ? 'block' : 'none' %>;margin-top:.75rem">
      <button type="button" id="cookie-test-btn-config" class="btn" style="background:rgba(15,98,254,.12);border:1px solid #0f62fe;color:#0f62fe;font-size:.85rem;padding:.4rem 1rem" onclick="runCookieTestConfig()">
        🔍 Verbindung testen
      </button>
      <div id="cookie-test-output-config" style="display:none;margin-top:.75rem;background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:.75rem 1rem;font-family:monospace;font-size:.8rem;line-height:1.6;white-space:pre-wrap;max-height:260px;overflow-y:auto"></div>
    </div>

  </div>

  <!-- ===== Spotify ===== -->
  <div class="card" id="oauth-credentials-card" style="display:<%= config.api_mode === 'cookie' ? 'none' : 'block' %>">
    <div class="card-title" data-i18n="config_section_spotify">Spotify</div>

    <div class="form-group">
      <label data-i18n="setup_step1_client_id">Client ID</label>
      <input type="text" name="client_id" value="<%= config.spotify && config.spotify.client_id || '' %>">
    </div>
    <div class="form-group">
      <label data-i18n="setup_step1_client_secret">Client Secret</label>
      <input type="password" name="client_secret" autocomplete="off"
             placeholder="<%= config.spotify && config.spotify.client_id ? '(unchanged)' : '' %>">
      <% if (config.spotify && config.spotify.client_id) { %>
      <p class="field-hint">Leave blank to keep existing value.</p>
      <% } %>
    </div>
    <div class="form-group">
      <label data-i18n="setup_step1_redirect">Redirect URI</label>
      <input type="url" name="redirect_uri" value="<%= config.spotify && config.spotify.redirect_uri || redirectUri %>">
    </div>
  </div>

  <!-- ===== Playlist ===== -->
  <div class="card">
    <div class="card-title" data-i18n="config_section_playlist">Playlist</div>
    <!-- Hidden field carries the ID to the server -->
    <input type="hidden" name="playlist_id" id="target_playlist_id" value="<%= config.playlist_id || '' %>">
    <!-- Card showing current selection -->
    <div id="target-playlist-card" style="display:<%= config.playlist_id ? 'flex' : 'none' %>;align-items:center;gap:.75rem;padding:.6rem .75rem;background:var(--bg2,#262626);border:1px solid var(--border);border-radius:6px;margin-bottom:.75rem">
      <img id="target-playlist-img" src="" alt="" style="width:40px;height:40px;border-radius:4px;object-fit:cover;display:none">
      <div style="flex:1;min-width:0">
        <div id="target-playlist-name" style="font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= config.playlist_id || '' %></div>
      </div>
      <button type="button" class="btn-remove" onclick="clearTargetPlaylist()" title="Remove">✕</button>
    </div>
    <div id="target-playlist-empty" style="display:<%= config.playlist_id ? 'none' : 'block' %>;color:var(--text-muted);font-size:.875rem;margin-bottom:.75rem" data-i18n="dash_playlist_empty">No playlist selected.</div>
    <div class="btn-row" style="margin-top:0">
      <button type="button" class="btn btn-primary" onclick="openPicker('target_playlist')" data-i18n="picker_select_playlist">🔍 Select from Spotify</button>
    </div>
  </div>

  <!-- ===== Podcasts ===== -->
  <div class="card">
    <div class="card-title" data-i18n="config_section_podcasts">Podcasts</div>

    <!-- Pin selection: dropdown -->
    <%
      const pinnedPod = (config.podcasts || []).find(p => p.position === 'first');
      const pinnedId = pinnedPod ? pinnedPod.id : '';
    %>
    <div class="form-group" style="margin-bottom:0.5rem;">
      <label data-i18n="config_podcast_pin_select">Podcast anheften (erste Position)</label>
      <select name="podcast_pin_id" id="podcast-pin-select" onchange="syncPinnedVisibility()">
        <option value="-1" <%= !pinnedId ? 'selected' : '' %> data-i18n="config_podcast_pin_none">Keinen anheften</option>
        <% (config.podcasts || []).forEach(function(p) { %>
        <option value="<%= p.id || '' %>" data-podcast-id="<%= p.id || '' %>" <%= pinnedId === p.id ? 'selected' : '' %>><%= p.name || p.id %></option>
        <% }); %>
      </select>
      <p class="field-hint" data-i18n="config_podcast_pin_hint">Dieser Podcast erscheint immer zuerst in der Playlist, unabhängig vom Mix-Muster.</p>
    </div>

    <!-- Pinned podcast inline preview (populated by syncPinnedVisibility) -->
    <div id="pinned-podcast-preview" style="margin-bottom:1rem;<%= !pinnedId ? 'display:none' : '' %>"></div>

    <!-- Alternate option -->
    <div class="form-group" style="margin-bottom:1rem;">
      <div class="checkbox-row">
        <input type="checkbox" id="podcast_alternate" name="podcast_alternate" value="1"
               <%= (config.podcast_alternate) ? 'checked' : '' %>>
        <label for="podcast_alternate" style="text-transform:none;letter-spacing:0" data-i18n="config_podcast_alternate">Podcasts alternieren (nicht nacheinander)</label>
      </div>
      <p class="field-hint" data-i18n="config_podcast_alternate_hint">Episoden aller Podcasts werden im Wechsel eingemischt statt erst alle Episoden eines Podcasts.</p>
    </div>

    <!-- Podcast edit list (below options) -->
    <div style="border-top: 1px solid var(--border); padding-top: 1rem;">
      <div class="card-title" style="font-size:0.85rem;margin-bottom:0.75rem;" data-i18n="config_podcast_edit_list">Podcasts bearbeiten</div>
      <div id="podcast-list" class="item-list">
        <% (config.podcasts || []).forEach(function(p, i) { %>
        <div class="item-entry draggable <%= p.position === 'first' ? 'podcast-pinned-entry' : '' %>"
             id="podcast-<%= i %>" draggable="true" data-podcast-id="<%= p.id || '' %>"
             style="<%= p.position === 'first' ? 'display:none' : '' %>">
          <span class="drag-handle" title="Drag to reorder">⠿</span>
          <div class="form-group" style="margin:0">
            <label data-i18n="config_podcast_name">Name</label>
            <input type="text" name="podcast_name[]" value="<%= p.name || '' %>" readonly style="background:var(--bg2,#262626);cursor:default">
            <input type="hidden" name="podcast_id[]" value="<%= p.id || '' %>" required>
          </div>
          <div class="form-group" style="margin:0;min-width:70px;max-width:110px">
            <label data-i18n="config_podcast_episodes">Episodes</label>
            <input type="number" name="podcast_episodes[]" value="<%= p.episodes || 1 %>" min="1" max="10">
          </div>
          <div class="form-group" style="margin:0;min-width:130px">
            <label data-i18n="config_podcast_mode">Mode</label>
            <select name="podcast_mode[]">
              <option value="newest"          <%= (p.mode || 'newest') === 'newest'          ? 'selected' : '' %> data-i18n="config_podcast_mode_newest">Newest</option>
              <option value="newest_unplayed" <%= (p.mode || 'newest') === 'newest_unplayed' ? 'selected' : '' %> data-i18n="config_podcast_mode_newest_unplayed">Newest unplayed</option>
              <option value="oldest_unplayed" <%= (p.mode || 'newest') === 'oldest_unplayed' ? 'selected' : '' %> data-i18n="config_podcast_mode_oldest_unplayed">Oldest unplayed</option>
            </select>
          </div>
          <button type="button" class="btn-remove" onclick="removeEntry(this.closest('.item-entry'))">✕</button>
        </div>
        <% }); %>
      </div>
      <div class="btn-row" style="margin-top:0.75rem;">
        <button type="button" class="btn btn-primary" onclick="openPicker('show')" data-i18n="picker_select_podcast">🔍 Select from Spotify</button>
      </div>
    </div>
  </div>

  <!-- ===== Music ===== -->
  <div class="card">
    <div class="card-title" data-i18n="config_section_music">Music</div>

    <!-- Total Songs & Shuffle -->
    <div class="form-group">
      <label data-i18n="config_total_songs">Target songs in playlist</label>
      <input type="number" id="total_songs" name="total_songs" value="<%= config.music && config.music.total_songs || 15 %>" min="1" max="200" oninput="updateMusicComposition()">
      <p class="field-hint" data-i18n="config_total_songs_hint">Total target number of music tracks in your playlist.</p>
    </div>
    <div class="form-group">
      <div class="checkbox-row">
        <input type="checkbox" id="shuffle" name="shuffle" value="1"
               <%= (config.music && config.music.shuffle !== false) ? 'checked' : '' %>>
        <label for="shuffle" style="text-transform:none;letter-spacing:0" data-i18n="config_shuffle">Shuffle songs</label>
      </div>
    </div>

    <!-- Live Composition & Percentage Breakdown Preview -->
    <div id="music-composition-box" style="background:var(--surface-2,#262626);border:1px solid var(--border);border-radius:6px;padding:1rem;margin:1.25rem 0;">
      <div style="font-weight:600;font-size:0.95rem;margin-bottom:0.25rem;display:flex;align-items:center;gap:0.5rem;" data-i18n="config_music_distribution_title">
        📊 Voraussichtliche Zusammensetzung der Playlist
      </div>
      <p class="field-hint" style="margin-bottom:0.75rem;" data-i18n="config_music_distribution_desc">
        Übersicht, wie sich deine Zielanzahl an Songs aus den vertrauten Quellen und der Genre-Entdeckung zusammensetzt:
      </p>

      <!-- 50/50 Split Progress Bar -->
      <div style="display:flex;height:24px;border-radius:4px;overflow:hidden;background:#111;margin-bottom:0.75rem;border:1px solid rgba(255,255,255,0.1);font-size:0.75rem;font-weight:600;line-height:24px;text-align:center;">
        <div id="bar-familiar" style="background:var(--accent,#0f62fe);color:#fff;transition:width 0.3s ease;white-space:nowrap;overflow:hidden;padding:0 4px;">50%</div>
        <div id="bar-discovery" style="background:#8a3ffc;color:#fff;transition:width 0.3s ease;white-space:nowrap;overflow:hidden;padding:0 4px;">50%</div>
      </div>

      <!-- Main ratio summary -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;font-size:0.85rem;margin-bottom:0.75rem;">
        <div style="background:rgba(15,98,254,0.12);border:1px solid rgba(15,98,254,0.3);border-radius:4px;padding:0.5rem 0.75rem;">
          <div style="color:var(--text-muted);" data-i18n="config_dist_familiar">Vertraute Quellen (Familiar)</div>
          <div id="summary-familiar-count" style="font-size:1.1rem;font-weight:700;color:#fff;">8 Songs (50%)</div>
        </div>
        <div style="background:rgba(138,63,252,0.12);border:1px solid rgba(138,63,252,0.3);border-radius:4px;padding:0.5rem 0.75rem;">
          <div style="color:var(--text-muted);" data-i18n="config_dist_discovery">Genre-Entdeckung (Discovery)</div>
          <div id="summary-discovery-count" style="font-size:1.1rem;font-weight:700;color:#fff;">7 Songs (50%)</div>
        </div>
      </div>

      <!-- Genre Cap / Actual Total Notice -->
      <div id="genre-cap-warning" style="display:none;background:rgba(241,194,27,0.12);border:1px solid rgba(241,194,27,0.4);border-radius:4px;padding:0.6rem 0.75rem;margin-bottom:0.75rem;color:var(--yellow);font-size:0.8rem;line-height:1.4;">
      </div>

      <!-- Familiar Source Pool Breakdown -->
      <div style="border-top:1px solid rgba(255,255,255,0.1);padding-top:0.75rem;">
        <div style="font-weight:600;font-size:0.85rem;margin-bottom:0.5rem;color:var(--text-muted);" data-i18n="config_dist_pool_title">
          Vertrauter Quell-Pool (wird gemischt & ausgewählt)
        </div>
        <div id="source-pool-chips" style="display:flex;flex-wrap:wrap;gap:0.5rem;font-size:0.8rem;">
          <!-- Dynamically populated chips -->
        </div>
        <div id="source-pool-warning" style="display:none;color:var(--yellow);font-size:0.8rem;margin-top:0.5rem;" data-i18n="config_dist_no_sources">
          ⚠️ Keine vertrauten Musikquellen aktiviert!
        </div>
      </div>
    </div>

    <!-- Section 1: Top-Tracks -->
    <div style="border-top:1px solid var(--border);padding-top:1rem;margin-top:1rem;">
      <div class="form-group">
        <div class="checkbox-row">
          <input type="checkbox" id="top_tracks_enabled" name="top_tracks_enabled" value="1"
                 <%= (config.music && config.music.top_tracks && config.music.top_tracks.enabled) ? 'checked' : '' %>
                 onchange="updateMusicComposition()">
          <label for="top_tracks_enabled" style="text-transform:none;letter-spacing:0;font-weight:600;" data-i18n="config_top_tracks">Enable top tracks</label>
        </div>
      </div>
      <div id="top-tracks-options" style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:0.5rem;">
        <div class="form-group" style="margin:0;">
          <label data-i18n="config_time_range">Time range</label>
          <select name="time_range">
            <% const tr = config.music && config.music.top_tracks && config.music.top_tracks.time_range || 'short_term'; %>
            <option value="short_term"  <%= tr === 'short_term'  ? 'selected' : '' %> data-i18n="config_time_range_short">Last month (~4 weeks)</option>
            <option value="medium_term" <%= tr === 'medium_term' ? 'selected' : '' %> data-i18n="config_time_range_medium">Last 6 months</option>
            <option value="long_term"   <%= tr === 'long_term'   ? 'selected' : '' %> data-i18n="config_time_range_long">All time</option>
          </select>
        </div>
        <div class="form-group" style="margin:0;">
          <label data-i18n="config_top_tracks_count">Anzahl Top-Tracks (0–50)</label>
          <input type="number" id="top_tracks_count" name="top_tracks_count"
                 value="<%= (config.music && config.music.top_tracks && config.music.top_tracks.count != null) ? config.music.top_tracks.count : 30 %>"
                 min="0" max="50" oninput="updateMusicComposition()">
        </div>
      </div>
      <p class="field-hint" style="margin-bottom:1rem;" data-i18n="config_top_tracks_hint">Spotify stellt maximal 50 Top-Tracks pro Zeitraum bereit.</p>
    </div>

    <!-- Section 2: Liked/Saved Songs -->
    <div style="border-top:1px solid var(--border);padding-top:1rem;">
      <div class="form-group">
        <div class="checkbox-row">
          <input type="checkbox" id="saved_tracks_enabled" name="saved_tracks_enabled" value="1"
                 <%= (config.music && config.music.saved_tracks && config.music.saved_tracks.enabled) ? 'checked' : '' %>
                 onchange="updateMusicComposition()">
          <label for="saved_tracks_enabled" style="text-transform:none;letter-spacing:0;font-weight:600;" data-i18n="config_saved_tracks">Enable liked/saved songs</label>
        </div>
      </div>
      <div class="form-group">
        <label data-i18n="config_saved_tracks_count">Saved songs fetch count</label>
        <input type="number" id="saved_tracks_count" name="saved_tracks_count"
               value="<%= config.music && config.music.saved_tracks && config.music.saved_tracks.count || 50 %>"
               min="1" max="500" oninput="updateMusicComposition()">
      </div>
    </div>

    <!-- Section 3: Source Playlists -->
    <div style="border-top:1px solid var(--border);padding-top:1rem;">
      <div class="card-title" style="font-size:0.95rem;margin-bottom:0.5rem;" data-i18n="config_playlists">Source playlists</div>
      <div id="playlist-list" class="item-list">
        <% (config.music && config.music.playlists || []).forEach(function(pl, i) { %>
        <div class="item-entry" id="pl-<%= i %>" data-playlist-id="<%= pl.id || '' %>" data-tracks-total="">
          <div class="form-group" style="margin:0">
            <label data-i18n="config_podcast_name">Name</label>
            <input type="text" name="pl_name[]" value="<%= pl.name || '' %>" readonly style="background:var(--bg2,#262626);cursor:default">
            <input type="hidden" name="pl_id[]" value="<%= pl.id || '' %>">
          </div>
          <button type="button" class="btn-remove" onclick="removeEntry(this.closest('.item-entry')); updateMusicComposition();">✕</button>
        </div>
        <% }); %>
      </div>
      <div class="btn-row" style="margin-top:0.75rem;">
        <button type="button" class="btn btn-primary" onclick="openPicker('playlist')" data-i18n="picker_select_playlist">🔍 Select from Spotify</button>
      </div>
    </div>

    <!-- Section 4: Genre Discovery -->
    <div style="border-top:1px solid var(--border);padding-top:1rem;margin-top:1rem;">
      <div class="card-title" style="font-size:0.95rem;margin-bottom:0.5rem;" data-i18n="config_dist_discovery">Genre Discovery</div>
      <div class="form-group">
        <label data-i18n="config_genres">Genre tags (comma-separated)</label>
        <input type="text" id="genres_input" name="genres" value="<%= config.music && config.music.genres ? config.music.genres.join(', ') : '' %>" placeholder="pop, indie rock, electronic" oninput="updateMusicComposition()">
        <p class="field-hint" data-i18n="config_genres_hint">Separate genres with commas or semicolons (e.g. pop, dance, indie). Note: Spotify returns up to 10 discovery tracks per genre search.</p>
        <button type="button" class="btn btn-secondary" onclick="openTasteModal()" data-i18n="config_genres_auto_detect">🎵 Auto-Detect Genres</button>
      </div>
    </div>
  </div>

  <!-- ===== Mix & Schedule ===== -->
  <div class="card">
    <div class="card-title" data-i18n="config_section_schedule">Mix & Schedule</div>
    <div class="form-group">
      <label data-i18n="config_mix_pattern">Mix pattern (P=podcast M=music)</label>
      <input type="text" name="mix_pattern" value="<%= config.mix_pattern || 'PMMMM' %>" placeholder="PMMMM">
    </div>
    <div class="form-group">
      <label data-i18n="config_refresh_interval">Refresh interval (e.g. 30m, 1h, 24h)</label>
      <input type="text" name="refresh_interval" value="<%= refreshInterval %>" placeholder="e.g. 30m, 1h, 24h">
    </div>
  </div>

  <div class="btn-row">
    <button type="submit" class="btn btn-primary" data-i18n="config_save">Save</button>
  </div>
</form>

<!-- Spotify Picker Modal -->
<div id="spotify-picker" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="picker-title">Select Item</h2>
      <button type="button" class="modal-close" onclick="closePicker()">&times;</button>
    </div>
    
    <div class="picker-tabs">
      <button type="button" class="picker-tab active" id="tab-library" onclick="switchPickerTab('library')" data-i18n="picker_tab_library">My Library</button>
      <button type="button" class="picker-tab" id="tab-search" onclick="switchPickerTab('search')" data-i18n="picker_tab_search">Search</button>
    </div>

    <!-- Search input -->
    <div class="picker-search-bar" id="picker-search-container" style="display: none; margin-top: 1rem; gap: 0.5rem;">
      <input type="text" id="picker-search-input" data-i18n="picker_search_placeholder" placeholder="Search Spotify..." onkeydown="if(event.key === 'Enter') performPickerSearch()">
      <button type="button" class="btn btn-primary" onclick="performPickerSearch()" data-i18n="logs_refresh">Search</button>
    </div>

    <div id="picker-loading" class="picker-loading" style="display: none;">
      <div class="spinner"></div>
    </div>

    <div id="picker-empty" class="picker-empty" style="display: none;">
      <span id="picker-empty-text"></span>
      <button type="button" id="picker-empty-search-btn" class="btn btn-ghost" style="display:none;margin-top:.75rem;font-size:.85rem" onclick="switchPickerTab('search')" data-i18n="picker_tab_search">Search</button>
    </div>

    <div class="picker-results-grid" id="picker-results">
      <!-- Results populated by JS -->
    </div>
  </div>
</div>

<!-- Auto-Detect Genres Modal -->
<div id="taste-modal" class="modal" onclick="if(event.target===this)closeTasteModal()">
  <div class="modal-content">
    <div class="modal-header">
      <h2 data-i18n="taste_modal_title">Auto-Detect Genres</h2>
      <button type="button" class="modal-close" onclick="closeTasteModal()">&times;</button>
    </div>

    <!-- Loading state -->
    <div id="taste-loading" class="picker-loading">
      <div class="spinner"></div>
      <p data-i18n="taste_modal_loading" style="margin-top:0.75rem;color:var(--text-muted)">Loading your Spotify taste data…</p>
    </div>

    <!-- Error state -->
    <div id="taste-error" style="display:none;color:#fa4d56;padding:1rem 0" data-i18n="taste_modal_error_generic"></div>

    <!-- Content (hidden until loaded) -->
    <div id="taste-content" style="display:none">
      <p data-i18n="taste_modal_instruction" style="color:var(--text-muted);font-size:0.9rem;margin-bottom:0.75rem"></p>
      <textarea id="taste-prompt-text" class="taste-prompt-readonly" rows="10" readonly style="width:100%;margin-bottom:0.5rem;padding:0.6rem;border:1px solid var(--border);border-radius:4px"></textarea>
      <div class="btn-row" style="margin-bottom:1.5rem">
        <button type="button" class="btn btn-secondary" id="taste-copy-btn" onclick="copyTastePrompt()" data-i18n="taste_modal_copy">📋 Copy prompt</button>
      </div>
      <div class="form-group" style="margin-bottom:0.75rem">
        <label data-i18n="taste_modal_result_label">Paste the AI's genre list here</label>
        <textarea id="taste-result-input" rows="6" placeholder="synth pop&#10;indie rock&#10;electronic&#10;..." style="width:100%;padding:0.6rem;border:1px solid var(--border);border-radius:4px;background:var(--bg2,#262626);color:var(--text);resize:vertical"></textarea>
      </div>
      <div class="btn-row">
        <button type="button" class="btn btn-primary" onclick="applyTasteGenres('replace')" data-i18n="taste_modal_apply_replace">Replace genres</button>
        <button type="button" class="btn btn-secondary" onclick="applyTasteGenres('add')" data-i18n="taste_modal_apply_add">Add to genres</button>
        <button type="button" class="btn" onclick="closeTasteModal()" data-i18n="taste_modal_cancel">Cancel</button>
      </div>
    </div>
  </div>
</div>

<script>
function onApiModeChange(val) {
  const isCookie = (val === 'cookie');
  document.getElementById('cookie-credentials').style.display = isCookie ? 'block' : 'none';
  document.getElementById('oauth-credentials-card').style.display = isCookie ? 'none' : 'block';
  document.getElementById('cookie-test-panel-config').style.display = isCookie ? 'block' : 'none';
  // Reset test output on mode switch
  document.getElementById('cookie-test-output-config').style.display = 'none';
  document.getElementById('cookie-test-output-config').textContent = '';
}

async function runCookieTestConfig() {
  const btn = document.getElementById('cookie-test-btn-config');
  const out = document.getElementById('cookie-test-output-config');
  btn.disabled = true;
  btn.textContent = '⏳ Teste …';
  out.style.display = 'block';
  out.textContent = 'Starte Diagnose …\n';

  // Read sp_dc from the input field — skip placeholder value
  const fieldVal = (document.querySelector('[name="spotify[sp_dc]"]') || {}).value || '';
  const spDc = (fieldVal && !fieldVal.startsWith('•')) ? fieldVal.trim() : '';

  try {
    const resp = await fetch('/api/test-cookie-login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sp_dc: spDc }),
    });
    const data = await resp.json();
    out.textContent = data.steps.join('\n');
    if (data.ok) {
      btn.style.background = 'rgba(36,161,72,.15)';
      btn.style.borderColor = '#24a148';
      btn.style.color = '#24a148';
      btn.textContent = '✅ Verbindung erfolgreich';
    } else {
      btn.style.background = 'rgba(218,30,40,.12)';
      btn.style.borderColor = '#da1e28';
      btn.style.color = '#da1e28';
      btn.textContent = '❌ Verbindung fehlgeschlagen';
    }
  } catch (e) {
    out.textContent += '\n❌ Netzwerkfehler: ' + e.message;
    btn.textContent = '❌ Fehler';
  } finally {
    btn.disabled = false;
  }
}

let podcastCount = <%= (config.podcasts || []).length %>;
let plCount      = <%= (config.music && config.music.playlists ? config.music.playlists.length : 0) %>;

// ── Drag-and-Drop reordering for podcast list ────────────────────────────────
let dragSrc = null;

function initDragItem(el) {
  el.addEventListener('dragstart', function (e) {
    dragSrc = el;
    el.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
    // Store empty string so Firefox allows drag
    e.dataTransfer.setData('text/plain', '');
  });
  el.addEventListener('dragend', function () {
    el.classList.remove('dragging');
    document.querySelectorAll('#podcast-list .item-entry').forEach(function (e) {
      e.classList.remove('drag-over');
    });
    dragSrc = null;
  });
  el.addEventListener('dragover', function (e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    if (dragSrc && dragSrc !== el) {
      document.querySelectorAll('#podcast-list .item-entry').forEach(function (e) {
        e.classList.remove('drag-over');
      });
      el.classList.add('drag-over');
    }
  });
  el.addEventListener('dragleave', function () {
    el.classList.remove('drag-over');
  });
  el.addEventListener('drop', function (e) {
    e.preventDefault();
    el.classList.remove('drag-over');
    if (!dragSrc || dragSrc === el) return;
    const list = document.getElementById('podcast-list');
    const items = Array.from(list.querySelectorAll('.item-entry'));
    const srcIdx = items.indexOf(dragSrc);
    const tgtIdx = items.indexOf(el);
    if (srcIdx < tgtIdx) {
      list.insertBefore(dragSrc, el.nextSibling);
    } else {
      list.insertBefore(dragSrc, el);
    }
    rebuildPinSelect();
  });
}

// Initialise drag on all existing podcast entries at page load
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('#podcast-list .item-entry').forEach(initDragItem);
  syncPinnedVisibility();
});

/**
 * Rebuilds the pin select options to match the current podcast-list order.
 * Preserves the selected podcast by show ID across reorders.
 */
function rebuildPinSelect() {
  const select = document.getElementById('podcast-pin-select');
  if (!select) return;

  // Remember currently selected podcast by ID
  const prevOpt = select.options[select.selectedIndex];
  const prevPinnedId = prevOpt ? (prevOpt.dataset.podcastId || '') : '';

  // Rebuild options (keep "none" at index 0)
  while (select.options.length > 1) select.remove(1);
  let hasPinned = false;
  
  // Select all podcast entries from both containers so the pinned one isn't missed/removed
  const entries = document.querySelectorAll('#pinned-podcast-preview .item-entry, #podcast-list .item-entry');
  entries.forEach(function (entry, idx) {
    const nameInput = entry.querySelector('input[name="podcast_name[]"]');
    const idInput   = entry.querySelector('input[name="podcast_id[]"]');
    const podId = (idInput && idInput.value.trim()) || (entry.dataset.podcastId || '');
    const label = (nameInput && nameInput.value.trim()) || podId || ('Podcast ' + (idx + 1));
    const opt = document.createElement('option');
    opt.value = podId;
    opt.dataset.podcastId = podId;
    opt.textContent = label;
    select.appendChild(opt);
    if (prevPinnedId && podId === prevPinnedId) hasPinned = true;
  });
  select.value = hasPinned ? prevPinnedId : '-1';

  syncPinnedVisibility();
}

/**
 * Moves the pinned podcast entry into the preview slot below the select,
 * and returns all others to the edit list.
 */
function syncPinnedVisibility() {
  const select  = document.getElementById('podcast-pin-select');
  const preview = document.getElementById('pinned-podcast-preview');
  const list    = document.getElementById('podcast-list');
  if (!select || !preview || !list) return;

  const selOpt   = select.options[select.selectedIndex];
  const pinnedId = selOpt ? (selOpt.dataset.podcastId || '') : '';

  // Return any previously previewed entry back to the list first
  Array.from(preview.children).forEach(function (el) {
    el.style.display = '';
    _restoreFromPreview(el);
    const idInput = el.querySelector('input[name="podcast_id[]"]');
    if (idInput) idInput.required = true;
    list.appendChild(el);
  });

  if (pinnedId && pinnedId !== '-1') {
    // Find the matching entry in the list and move it to the preview
    const target = list.querySelector('.item-entry[data-podcast-id="' + pinnedId + '"]');
    if (target) {
      target.style.display = '';
      // Hide the remove button while pinned (use the select to un-pin instead)
      const removeBtn = target.querySelector('.btn-remove');
      if (removeBtn) removeBtn.style.display = 'none';
      preview.appendChild(target);
      preview.style.display = '';
      return;
    }
  }
  preview.style.display = 'none';
}

function _restoreFromPreview(el) {
  // Restore remove button when entry moves back to the list
  const removeBtn = el.querySelector('.btn-remove');
  if (removeBtn) removeBtn.style.display = '';
}

function removeEntry(el) {
  el.remove();
  rebuildPinSelect();
}

function addPodcast(id = '', name = '') {
  const i = podcastCount++;
  const div = document.createElement('div');
  div.className = 'item-entry draggable';
  div.id = 'podcast-' + i;
  div.draggable = true;
  div.dataset.podcastId = id;
  div.innerHTML = `
    <span class="drag-handle" title="Drag to reorder">⠿</span>
    <div class="form-group" style="margin:0">
      <label>${DDLang.t('config_podcast_name')}</label>
      <input type="text" name="podcast_name[]" value="${name}" readonly style="background:var(--bg2,#262626);cursor:default">
      <input type="hidden" name="podcast_id[]" value="${id}" required>
    </div>
    <div class="form-group" style="margin:0;min-width:70px;max-width:110px">
      <label>${DDLang.t('config_podcast_episodes')}</label>
      <input type="number" name="podcast_episodes[]" value="1" min="1" max="10">
    </div>
    <button type="button" class="btn-remove" onclick="removeEntry(this.closest('.item-entry'))">✕</button>
  `;
  const list = document.getElementById('podcast-list');
  list.appendChild(div);
  initDragItem(div);
  rebuildPinSelect();
}

function addPlaylist(id = '', name = '', tracksTotal = '') {
  const i = plCount++;
  const div = document.createElement('div');
  div.className = 'item-entry';
  div.id = 'pl-' + i;
  div.dataset.playlistId = id;
  div.innerHTML = `
    <div class="form-group" style="margin:0">
      <label>${DDLang.t('config_podcast_name')}</label>
      <input type="text" name="pl_name[]" value="${name}" readonly style="background:var(--bg2,#262626);cursor:default">
      <input type="hidden" name="pl_id[]" value="${id}">
    </div>
    <button type="button" class="btn-remove" onclick="removeEntry(this.closest('.item-entry')); updateMusicComposition();">✕</button>
  `;
  document.getElementById('playlist-list').appendChild(div);

  // Only trust tracksTotal if it's a positive number; otherwise fetch from API
  const knownTotal = tracksTotal != null && tracksTotal !== '' && parseInt(tracksTotal, 10) > 0;
  if (knownTotal) {
    div.dataset.tracksTotal = parseInt(tracksTotal, 10);
    updateMusicComposition();
  } else {
    fetchPlaylistTrackCount(id, div);
  }
}

async function fetchPlaylistTrackCount(id, element) {
  if (!id) return;
  try {
    const resp = await fetch('/api/playlist-info/' + encodeURIComponent(id));
    if (resp.ok) {
      const data = await resp.json();
      if (data && data.tracks_total != null) {
        element.dataset.tracksTotal = data.tracks_total;
        updateMusicComposition();
      }
    }
  } catch(e) { /* ignore */ }
}

function clearTargetPlaylist() {
  document.getElementById('target_playlist_id').value = '';
  document.getElementById('target-playlist-card').style.display = 'none';
  document.getElementById('target-playlist-empty').style.display = 'block';
}

function setTargetPlaylist(id, name, image) {
  document.getElementById('target_playlist_id').value = id;
  document.getElementById('target-playlist-name').textContent = name;
  const img = document.getElementById('target-playlist-img');
  if (image) { img.src = image; img.style.display = 'block'; }
  else { img.style.display = 'none'; }
  document.getElementById('target-playlist-card').style.display = 'flex';
  document.getElementById('target-playlist-empty').style.display = 'none';
}

// On page load: fetch Spotify name for the already-saved target playlist and track counts for source playlists
(async function loadInitialPlaylistData() {
  const targetId = document.getElementById('target_playlist_id')?.value;
  if (targetId) {
    try {
      const resp = await fetch('/api/playlist-info/' + encodeURIComponent(targetId));
      if (resp.ok) {
        const data = await resp.json();
        setTargetPlaylist(data.id, data.name, data.image);
      }
    } catch(e) { /* silent */ }
  }

  // Fetch track counts for source playlists configured on load
  const plEntries = document.querySelectorAll('#playlist-list .item-entry');
  for (const entry of plEntries) {
    const id = entry.dataset.playlistId || entry.querySelector('input[name="pl_id[]"]')?.value;
    if (id) {
      fetchPlaylistTrackCount(id, entry);
    }
  }
})();

// Spotify Picker Modal JS
let currentPickerType = 'show'; // 'show' or 'playlist'
let currentPickerTab  = 'library'; // 'library' or 'search'

function openPicker(type) {
  currentPickerType = type;
  currentPickerTab = 'library';

  const titleEl = document.getElementById('picker-title');
  if (type === 'show') {
    titleEl.innerHTML = DDLang.t('config_section_podcasts') + ' - ' + DDLang.t('picker_select');
  } else {
    titleEl.innerHTML = DDLang.t('config_playlists') + ' - ' + DDLang.t('picker_select');
  }

  // For playlists: hide Search tab — only own playlists can be used as music source in Dev Mode
  const isPlaylistPicker = (type === 'playlist' || type === 'target_playlist');
  document.getElementById('tab-search').style.display = isPlaylistPicker ? 'none' : '';

  document.getElementById('picker-search-input').value = '';
  document.getElementById('tab-library').classList.add('active');
  document.getElementById('tab-search').classList.remove('active');
  document.getElementById('picker-search-container').style.display = 'none';
  document.getElementById('picker-empty').style.display = 'none';
  document.getElementById('picker-empty-text').textContent = '';
  document.getElementById('picker-empty-search-btn').style.display = 'none';
  document.getElementById('spotify-picker').classList.add('show');

  loadLibraryData();
}

function closePicker() {
  document.getElementById('spotify-picker').classList.remove('show');
}

function switchPickerTab(tab) {
  currentPickerTab = tab;
  document.getElementById('tab-library').classList.toggle('active', tab === 'library');
  document.getElementById('tab-search').classList.toggle('active', tab === 'search');
  
  const searchContainer = document.getElementById('picker-search-container');
  if (tab === 'search') {
    searchContainer.style.display = 'flex';
    document.getElementById('picker-results').innerHTML = '';
    document.getElementById('picker-empty').style.display = 'none';
    document.getElementById('picker-search-input').focus();
  } else {
    searchContainer.style.display = 'none';
    loadLibraryData();
  }
}

async function loadLibraryData() {
  const resultsGrid = document.getElementById('picker-results');
  const loadingEl = document.getElementById('picker-loading');
  const emptyEl = document.getElementById('picker-empty');

  resultsGrid.innerHTML = '';
  loadingEl.style.display = 'block';
  emptyEl.style.display = 'none';

  try {
    const apiType = currentPickerType === 'show' ? 'show' : 'playlist';
    const apiMode = document.querySelector('[name="api_mode"]')?.value || '<%= config.api_mode || "oauth" %>';
    const endpoint = apiType === 'show' ? '/api/user-podcasts' : '/api/user-playlists';
    const resp = await fetch(`${endpoint}?mode=${encodeURIComponent(apiMode)}`);
    if (!resp.ok) {
      const errData = await resp.json().catch(() => ({}));
      throw new Error(errData.error || `HTTP ${resp.status}`);
    }

    const items = await resp.json();
    loadingEl.style.display = 'none';

    if (!items || items.length === 0) {
      const isShow = currentPickerType === 'show';
      const isPlaylist = (currentPickerType === 'playlist' || currentPickerType === 'target_playlist');
      document.getElementById('picker-empty-text').textContent = isShow
        ? DDLang.t('picker_empty_shows') || 'No saved podcasts found. Use Search to find shows by name.'
        : DDLang.t('picker_empty_playlists') || 'No playlists found in your library.';
      // Show "Search" button only for podcasts (playlists can't be searched in Dev Mode)
      document.getElementById('picker-empty-search-btn').style.display = isShow ? 'inline-block' : 'none';
      emptyEl.style.display = 'block';
      return;
    }

    renderPickerItems(items);
  } catch (e) {
    loadingEl.style.display = 'none';
    resultsGrid.innerHTML = `<p style="color: var(--red); text-align: center; padding: 1rem;">${e.message}</p>`;
  }
}

async function performPickerSearch() {
  const query = document.getElementById('picker-search-input').value.trim();
  if (!query) return;

  const resultsGrid = document.getElementById('picker-results');
  const loadingEl = document.getElementById('picker-loading');
  const emptyEl = document.getElementById('picker-empty');

  resultsGrid.innerHTML = '';
  loadingEl.style.display = 'block';
  emptyEl.style.display = 'none';

  try {
    const apiType = currentPickerType === 'show' ? 'show' : 'playlist';
    const apiMode = document.querySelector('[name="api_mode"]')?.value || '<%= config.api_mode || "oauth" %>';
    const resp = await fetch(`/api/search?type=${apiType}&q=${encodeURIComponent(query)}&mode=${encodeURIComponent(apiMode)}`);
    if (!resp.ok) {
      const errData = await resp.json().catch(() => ({}));
      throw new Error(errData.error || `HTTP ${resp.status}`);
    }

    const items = await resp.json();
    loadingEl.style.display = 'none';

    if (!items || items.length === 0) {
      emptyEl.style.display = 'block';
      return;
    }

    renderPickerItems(items);
  } catch (e) {
    loadingEl.style.display = 'none';
    resultsGrid.innerHTML = `<p style="color: var(--red); text-align: center; padding: 1rem;">Search failed: ${e.message}</p>`;
  }
}

function renderPickerItems(items) {
  const resultsGrid = document.getElementById('picker-results');
  resultsGrid.innerHTML = '';

  items.forEach(item => {
    const card = document.createElement('div');
    const isPlaylist = currentPickerType === 'playlist' || currentPickerType === 'target_playlist';
    const isForeign = isPlaylist && item.is_own === false;
    card.className = 'picker-result-card' + (isForeign ? ' picker-result-disabled' : '');
    const imageUrl = item.images && item.images.length > 0 ? item.images[item.images.length - 1].url : '/img/bob/standing.png';
    if (!isForeign) {
      card.onclick = () => selectPickerItem(item.id, item.name, imageUrl, item.tracks_total);
    }
    const subtext = (currentPickerType === 'show') ? item.publisher : item.owner;

    const warningHtml = isForeign ? `
      <div class="picker-foreign-warning" title="Diese Playlist gehört einem anderen Nutzer. Im Spotify Dev Mode können nur eigene Playlists gelesen werden.">
        ⚠️ Nicht deine Playlist
      </div>` : '';

    card.innerHTML = `
      <img src="${imageUrl}" alt="${item.name}">
      <div class="picker-result-info">
        <div class="picker-result-name">${item.name}</div>
        <div class="picker-result-subtext">${subtext || ''}</div>
        ${warningHtml}
      </div>
      <button type="button" class="btn btn-ghost select-btn" ${isForeign ? 'disabled title="Nur eigene Playlists können als Musikquelle verwendet werden"' : ''}>${DDLang.t('picker_add') || 'Hinzufügen'}</button>
    `;

    resultsGrid.appendChild(card);
  });
}

function selectPickerItem(id, name, image, tracksTotal) {
  if (currentPickerType === 'show') {
    addPodcast(id, name);
  } else if (currentPickerType === 'target_playlist') {
    setTargetPlaylist(id, name, image);
  } else {
    addPlaylist(id, name, tracksTotal);
  }
  closePicker();
}
function openTasteModal() {
  const modal = document.getElementById('taste-modal');
  modal.classList.add('show');
  document.getElementById('taste-loading').style.display = '';
  document.getElementById('taste-error').style.display = 'none';
  document.getElementById('taste-content').style.display = 'none';
  document.getElementById('taste-result-input').value = '';
  fetch('/api/taste-prompt')
    .then(r => r.ok ? r.json() : r.json().then(e => Promise.reject(e)))
    .then(data => {
      document.getElementById('taste-prompt-text').value = data.prompt;
      document.getElementById('taste-loading').style.display = 'none';
      document.getElementById('taste-content').style.display = '';
      DDLang.load(); // re-apply translations to newly shown elements
    })
    .catch(err => {
      document.getElementById('taste-loading').style.display = 'none';
      const errEl = document.getElementById('taste-error');
      errEl.style.display = '';
      const isAuth = err && err.error && err.error.includes('authenticated');
      errEl.textContent = isAuth
        ? (DDLang.t('taste_modal_error_auth') || 'Not authenticated.')
        : (DDLang.t('taste_modal_error_generic') || 'Could not load taste data.');
    });
}

function closeTasteModal() {
  document.getElementById('taste-modal').classList.remove('show');
}

function copyTastePrompt() {
  const text = document.getElementById('taste-prompt-text').value;
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.getElementById('taste-copy-btn');
    const original = btn.textContent;
    btn.textContent = DDLang.t('taste_modal_copied') || '✓ Copied!';
    setTimeout(() => { btn.textContent = original; }, 2000);
  });
}

function applyTasteGenres(mode) {
  const raw = document.getElementById('taste-result-input').value;
  // Split by newline first, then comma/semicolon as fallback
  const lines = raw.split(/[\n,;]+/);
  const genres = lines
    .map(l => l.replace(/^[-*•]\s*/, '').trim())                      // strip bullet chars
    .map(l => l.replace(/[^a-zA-Z0-9äöüÄÖÜß \-]/g, '').trim())      // remove stray special chars
    .filter(l => l.length > 0 && l.length <= 40);                     // skip empty or sentence-length
  if (genres.length === 0) return;
  const genresInput = document.querySelector('input[name="genres"]');
  if (mode === 'add') {
    const existing = genresInput.value.split(',').map(g => g.trim()).filter(Boolean);
    const merged = [...existing];
    for (const g of genres) {
      if (!merged.some(e => e.toLowerCase() === g.toLowerCase())) merged.push(g);
    }
    genresInput.value = merged.join(', ');
  } else {
    genresInput.value = genres.join(', ');
  }
  updateMusicComposition();
  closeTasteModal();
}

// ---------------------------------------------------------------------------
// Dynamic Music Composition & Percentage Calculation
// ---------------------------------------------------------------------------
function updateMusicComposition() {
  const totalSongsEl = document.getElementById('total_songs');
  const genresEl = document.getElementById('genres_input');
  const topTracksCheck = document.getElementById('top_tracks_enabled');
  const topTracksCountEl = document.getElementById('top_tracks_count');
  const savedTracksCheck = document.getElementById('saved_tracks_enabled');
  const savedTracksCountEl = document.getElementById('saved_tracks_count');
  const playlistItems = document.querySelectorAll('#playlist-list .item-entry');

  if (!totalSongsEl) return;

  const totalSongs = Math.max(1, parseInt(totalSongsEl.value, 10) || 15);
  const rawGenres = (genresEl ? genresEl.value : '').split(/[,;\n\r]+/).map(s => s.trim()).filter(Boolean);
  const genreCount = rawGenres.length;
  const hasGenres = genreCount > 0;

  // 1. Calculate Target split
  const targetFamiliar = hasGenres ? Math.ceil(totalSongs / 2) : totalSongs;
  const targetDiscovery = hasGenres ? (totalSongs - targetFamiliar) : 0;

  // 2. Calculate Familiar Pool capacity from all sources
  const topTracksEnabled = topTracksCheck && topTracksCheck.checked;
  const topTracksCount = topTracksEnabled ? Math.min(50, Math.max(0, parseInt(topTracksCountEl?.value || '30', 10) || 0)) : 0;

  const savedTracksEnabled = savedTracksCheck && savedTracksCheck.checked;
  const savedTracksCount = savedTracksEnabled ? Math.max(0, parseInt(savedTracksCountEl?.value || '50', 10) || 0) : 0;

  // Sum exact/known playlist tracks from DOM data attributes (fallback to 50 per playlist if not yet loaded)
  let totalPlaylistTracks = 0;
  const playlistItemsArr = Array.from(playlistItems);
  playlistItemsArr.forEach(entry => {
    const rawTotal = entry.dataset.tracksTotal;
    if (rawTotal !== '' && rawTotal != null && !isNaN(parseInt(rawTotal, 10))) {
      totalPlaylistTracks += parseInt(rawTotal, 10);
    } else {
      totalPlaylistTracks += 50; // estimate until fetched
    }
  });

  const totalFamiliarPool = (topTracksEnabled ? topTracksCount : 0) +
                            (savedTracksEnabled ? savedTracksCount : 0) +
                            totalPlaylistTracks;

  // Actual familiar songs that can be placed in playlist
  const actualFamiliarCount = Math.min(targetFamiliar, totalFamiliarPool);

  // 3. Calculate Discovery capacity (max 10 tracks per genre search in Spotify Dev Mode)
  const maxPossibleDiscovery = genreCount * 10;
  const actualDiscoveryCount = hasGenres ? Math.min(targetDiscovery, maxPossibleDiscovery) : 0;

  const actualTotalMusic = actualFamiliarCount + actualDiscoveryCount;

  // Calculate actual percentages (guard against 0 total music)
  const familiarPct = actualTotalMusic > 0 ? Math.round((actualFamiliarCount / actualTotalMusic) * 100) : 0;
  const discoveryPct = actualTotalMusic > 0 ? (100 - familiarPct) : 0;

  const barFamiliar = document.getElementById('bar-familiar');
  const barDiscovery = document.getElementById('bar-discovery');
  const sumFamiliar = document.getElementById('summary-familiar-count');
  const sumDiscovery = document.getElementById('summary-discovery-count');
  const capWarningEl = document.getElementById('genre-cap-warning');

  // Update progress bar
  if (barFamiliar && barDiscovery) {
    if (actualTotalMusic === 0) {
      barFamiliar.style.width = '0%';
      barFamiliar.textContent = '';
      barDiscovery.style.width = '0%';
      barDiscovery.textContent = '';
    } else if (actualDiscoveryCount === 0) {
      barFamiliar.style.width = '100%';
      barFamiliar.textContent = `100% (${actualFamiliarCount})`;
      barDiscovery.style.width = '0%';
      barDiscovery.textContent = '';
    } else {
      barFamiliar.style.width = familiarPct + '%';
      barFamiliar.textContent = `${familiarPct}% (${actualFamiliarCount})`;
      barDiscovery.style.width = discoveryPct + '%';
      barDiscovery.textContent = `${discoveryPct}% (${actualDiscoveryCount})`;
    }
  }

  // Update summary cards
  if (sumFamiliar) {
    if (totalFamiliarPool < targetFamiliar) {
      sumFamiliar.innerHTML = `<span style="color:var(--yellow);">${actualFamiliarCount} Songs (${familiarPct}%)</span> <span style="font-size:0.75rem;color:var(--text-muted);font-weight:normal;">(Ziel: ${targetFamiliar})</span>`;
    } else {
      sumFamiliar.textContent = `${actualFamiliarCount} Songs (${familiarPct}%)`;
    }
  }
  if (sumDiscovery) {
    if (hasGenres && targetDiscovery > maxPossibleDiscovery) {
      sumDiscovery.innerHTML = `<span style="color:var(--yellow);">${actualDiscoveryCount} Songs (${discoveryPct}%)</span> <span style="font-size:0.75rem;color:var(--text-muted);font-weight:normal;">(Ziel: ${targetDiscovery})</span>`;
    } else {
      sumDiscovery.textContent = `${actualDiscoveryCount} Songs (${discoveryPct}%)`;
    }
  }

  // Combined warnings notice
  if (capWarningEl) {
    const warnings = [];
    const isFamiliarShort = totalFamiliarPool < targetFamiliar;
    const isDiscoveryShort = hasGenres && targetDiscovery > maxPossibleDiscovery;

    if (isFamiliarShort) {
      const famTpl = DDLang.t('config_dist_familiar_cap_warning', '⚠️ Deine vertrauten Quellen liefern maximal {pool} Songs (Ziel: {target}).');
      warnings.push(famTpl.replace('{pool}', totalFamiliarPool).replace('{target}', targetFamiliar));
    }
    if (isDiscoveryShort) {
      const genTpl = DDLang.t('config_dist_genre_cap_warning', '⚠️ Mit {count} Genres kann Spotify maximal {max} Discovery-Songs liefern (max. 10 pro Genre).');
      warnings.push(genTpl.replace('{count}', genreCount).replace('{max}', maxPossibleDiscovery));
    }
    if (isFamiliarShort || isDiscoveryShort) {
      const totalTpl = DDLang.t('config_dist_total_short_warning', 'Die fertige Playlist wird daher voraussichtlich nur insgesamt {actual} statt {target} Songs enthalten.');
      warnings.push(totalTpl.replace('{actual}', actualTotalMusic).replace('{target}', totalSongs));
    }

    if (warnings.length > 0) {
      capWarningEl.innerHTML = warnings.join('<br>');
      capWarningEl.style.display = 'block';
    } else {
      capWarningEl.style.display = 'none';
    }
  }

  // 4. Calculate Familiar Pool Breakdown Chips
  const chipsContainer = document.getElementById('source-pool-chips');
  const warningEl = document.getElementById('source-pool-warning');

  if (chipsContainer) {
    chipsContainer.innerHTML = '';
    const playlistCount = playlistItems.length;

    if (topTracksEnabled && topTracksCount > 0) {
      const pct = totalFamiliarPool > 0 ? Math.round((topTracksCount / totalFamiliarPool) * 100) : 0;
      chipsContainer.innerHTML += `
        <div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);border-radius:4px;padding:0.3rem 0.6rem;display:flex;align-items:center;gap:0.4rem;">
          <span style="color:#0f62fe;">●</span> <span>Top-Tracks:</span> <strong>${topTracksCount}</strong> <span style="color:var(--text-muted);font-size:0.75rem;">(~${pct}% Pool)</span>
        </div>`;
    }

    if (savedTracksEnabled && savedTracksCount > 0) {
      const pct = totalFamiliarPool > 0 ? Math.round((savedTracksCount / totalFamiliarPool) * 100) : 0;
      chipsContainer.innerHTML += `
        <div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);border-radius:4px;padding:0.3rem 0.6rem;display:flex;align-items:center;gap:0.4rem;">
          <span style="color:#24a148;">●</span> <span>Likes / Saved:</span> <strong>${savedTracksCount}</strong> <span style="color:var(--text-muted);font-size:0.75rem;">(~${pct}% Pool)</span>
        </div>`;
    }

    if (playlistCount > 0) {
      const pct = totalFamiliarPool > 0 ? Math.round((totalPlaylistTracks / totalFamiliarPool) * 100) : 0;
      chipsContainer.innerHTML += `
        <div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);border-radius:4px;padding:0.3rem 0.6rem;display:flex;align-items:center;gap:0.4rem;">
          <span style="color:#f1c21b;">●</span> <span>${playlistCount} ${playlistCount === 1 ? 'Playlist' : 'Playlists'}:</span> <strong>${totalPlaylistTracks}</strong> <span style="color:var(--text-muted);font-size:0.75rem;">(~${pct}% Pool)</span>
        </div>`;
    }

    if (!topTracksEnabled && !savedTracksEnabled && playlistCount === 0) {
      if (warningEl) warningEl.style.display = 'block';
    } else {
      if (warningEl) warningEl.style.display = 'none';
    }
  }
}

// Initial calculation on page load
document.addEventListener('DOMContentLoaded', updateMusicComposition);
// Re-run once i18n JSON strings are fully loaded
if (window.DDLang && window.DDLang.onReady) {
  window.DDLang.onReady(updateMusicComposition);
}
// Also trigger immediately in case DOM is already ready
updateMusicComposition();
</script>
