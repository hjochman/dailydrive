<h1 data-i18n="logs_title">Logs</h1>

<% if (flash) { %>
<div class="alert alert-<%= flash.type %>" style="margin-bottom:1rem"><%= flash.message %></div>
<% } %>

<div class="btn-row" style="margin-bottom:1rem">
  <button class="btn btn-ghost" onclick="loadLogs()" data-i18n="logs_refresh">Refresh</button>
</div>

<% if (logContent && logContent.length > 0) { %>
<pre class="log-output" id="log-output"></pre>
<script type="application/json" id="log-data"><%- JSON.stringify(logContent).replace(/</g, '\\u003c') %></script>
<% } else { %>
<div class="card">
  <p style="color:var(--text-muted)" data-i18n="logs_empty">No log entries yet.</p>
</div>
<% } %>

<script>
const logEl = document.getElementById('log-output');

// Render log text line by line; ERROR / WARN lines get highlighted via CSS classes.
// Uses textContent only (no innerHTML) so log content can never inject markup.
function renderLog(text) {
  logEl.textContent = '';
  text.split('\n').forEach((line, i, arr) => {
    const span = document.createElement('span');
    span.className = 'log-line';
    if (line.includes('[ERROR]')) span.className += ' log-error';
    else if (line.includes('[WARN]')) span.className += ' log-warn';
    span.textContent = line + (i < arr.length - 1 ? '\n' : '');
    logEl.appendChild(span);
  });
  logEl.scrollTop = logEl.scrollHeight;
}

const dataEl = document.getElementById('log-data');
if (logEl && dataEl) renderLog(JSON.parse(dataEl.textContent));

async function loadLogs() {
  const res = await fetch('/logs?raw=1');
  const text = await res.text();
  if (logEl) {
    renderLog(text);
  } else {
    location.reload();
  }
}
</script>
