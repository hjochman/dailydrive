<h1 data-i18n="setup_title">Setup</h1>
<p style="color:var(--text-muted);margin-bottom:1.5rem" data-i18n="setup_intro">I'll guide you step by step.</p>

<% if (page === 'setup_success') { %>
<!-- ===== Success ===== -->
<div class="card" style="text-align:center;padding:3rem 2rem">
  <img src="/img/bob/bob-standing-BECrMjXJ.webp" style="height:160px;margin-bottom:1.5rem;filter:drop-shadow(0 0 32px rgba(15,98,254,.5))">
  <h2 data-i18n="setup_success_title">Successfully connected!</h2>
  <p style="color:var(--text-muted);margin:0.75rem 0 1.5rem" data-i18n="setup_success_desc">Daily Drive is now connected to your Spotify account.</p>
  <a href="/" class="btn btn-primary" data-i18n="setup_success_go_dash">Go to Dashboard</a>
</div>

<% } else { %>

<%
  let isLanHttp = false;
  let loopbackRedirectUri = redirectUri;
  try {
    const u = new URL(redirectUri);
    isLanHttp = u.protocol === 'http:' && u.hostname !== '127.0.0.1' && u.hostname !== 'localhost';
    loopbackRedirectUri = `${u.protocol}//127.0.0.1${u.port ? ':' + u.port : ''}${u.pathname}`;
  } catch (e) {}
%>

<% if (flash) { %>
<div class="alert alert-<%= flash.type %>" style="margin-bottom:1.5rem">
  <div><%= flash.message %></div>
  <% if (flash.message && (flash.message.includes('EACCES') || flash.message.includes('permission denied'))) { %>
  <div style="margin-top:0.75rem;padding-top:0.75rem;border-top:1px solid rgba(255,255,255,0.15);font-size:0.85rem;line-height:1.5">
    <strong style="display:block;margin-bottom:0.35rem" data-i18n="eacces_help_title">📁 Berechtigungsproblem auf der Synology NAS beheben:</strong>
    <ol style="margin:0;padding-left:1.25rem">
      <li data-i18n="eacces_help_step1">Öffne die <strong>File Station</strong> im Synology DSM.</li>
      <li data-i18n="eacces_help_step2">Navigiere zum gemounteten Ordner (z. B. <code>docker/dailydrive/data</code>).</li>
      <li data-i18n="eacces_help_step3">Rechtsklick auf den Ordner <code>data</code> → <strong>Eigenschaften</strong> → Reiter <strong>Berechtigung</strong>.</li>
      <li data-i18n="eacces_help_step4">Stelle sicher, dass <strong>Everyone / Jeder</strong> Lese- und Schreibrechte besitzt (inkl. Haken bei <em>"Auf diesen Ordner, Unterordner und Dateien anwenden"</em>).</li>
    </ol>
  </div>
  <% } %>
</div>
<% } %>

<%
  const isCookieMode = (config.api_mode === 'cookie');
%>

<!-- ===== Step indicator ===== -->
<div class="steps-indicator">
  <div class="step-pill <%= step >= 1 ? (step > 1 ? 'done' : 'active') : '' %>">1</div>
  <div class="step-pill <%= isCookieMode ? 'skipped' : (step >= 2 ? (step > 2 ? 'done' : 'active') : '') %>">2</div>
  <div class="step-pill <%= step >= 3 ? (step > 3 ? 'done' : 'active') : '' %>">3</div>
</div>

<div class="wizard-layout">
  <!-- ===== Left: content ===== -->
  <div>

    <!-- Step 1 -->
    <div class="step-panel <%= step === 1 ? 'active' : '' %>">
      <h2>Step 1: Spotify Connection</h2>

      <form action="/setup/credentials" method="POST" id="step1-form">

        <!-- API mode selector -->
        <div class="form-group" style="margin-bottom:1.25rem">
          <label style="margin-bottom:0.5rem;display:block" data-i18n="setup_backend_label">Backend</label>
          <div class="mode-selector">
            <label class="mode-option">
              <input type="radio" name="api_mode" value="oauth" id="mode-oauth"
                <%= isCookieMode ? '' : 'checked' %> onchange="onModeChange()">
              <div class="mode-card">
                <strong data-i18n="setup_mode_oauth_title">OAuth (recommended)</strong>
                <p data-i18n="setup_mode_oauth_desc">Official Spotify API. Requires a free Developer App.</p>
              </div>
            </label>
            <label class="mode-option">
              <input type="radio" name="api_mode" value="cookie" id="mode-cookie"
                <%= isCookieMode ? 'checked' : '' %> onchange="onModeChange()">
              <div class="mode-card">
                <strong data-i18n="setup_mode_cookie_title">Unofficial Spotify Web API</strong>
                <p data-i18n="setup_mode_cookie_desc">No Developer Account needed. Only the sp_dc cookie from your browser.</p>
              </div>
            </label>
          </div>
        </div>

        <!-- OAuth fields -->
        <div id="oauth-fields" style="display:<%= isCookieMode ? 'none' : 'block' %>">
          <ul class="hint-list" style="margin-bottom:.75rem">
            <li>
              <span data-i18n="setup_step1_hint1">Go to</span>
              <a href="https://developer.spotify.com/dashboard" target="_blank" rel="noopener">developer.spotify.com/dashboard</a>
              <span data-i18n="setup_step1_hint2">and sign in.</span>
            </li>
            <li data-i18n="setup_step1_hint3">Click <strong>"Create App"</strong>.</li>
            <li>
              <span data-i18n="setup_step1_hint4">Enter exactly this value as <strong>Redirect URI</strong>:</span>
              <% if (isLanHttp) { %>
                <div style="margin: 0.5rem 0; padding: 0.75rem; background: rgba(241, 194, 27, 0.1); border-left: 4px solid #f1c21b; border-radius: 4px; font-size: 0.85rem;">
                  <strong style="color: #f1c21b; display: block; margin-bottom: 0.25rem;" data-i18n="setup_nas_warning_title">⚠️ NAS / LAN HTTP Setup Detected</strong>
                  <span style="color: var(--text-muted);" data-i18n="setup_nas_warning_desc">Spotify requires HTTPS for LAN IP redirect URIs. Since you are accessing via HTTP IP, you must use the loopback address in Spotify.</span>
                </div>
                <div class="redirect-uri-box" id="redirect-uri-display"><%= loopbackRedirectUri %></div>
                <p class="field-hint" data-i18n="setup_step1_hint_nas_loopback" style="margin-top:.4rem">
                  Use this loopback address in your Spotify Developer Dashboard instead of your NAS IP.
                </p>
              <% } else { %>
                <div class="redirect-uri-box" id="redirect-uri-display"><%= redirectUri %></div>
                <p class="field-hint" data-i18n="setup_step1_hint4b" style="margin-top:.4rem">
                  ⚠️ Spotify only accepts <code>127.0.0.1</code> — <strong>not</strong> <code>localhost</code>.
                </p>
              <% } %>
            </li>
            <li data-i18n="setup_step1_hint5">Check both <strong>Web API</strong> and <strong>Web Playback SDK</strong>.</li>
            <li data-i18n="setup_step1_hint6">Open <strong>Settings → User Management</strong> and add your Spotify email.</li>
          </ul>

          <div class="form-group">
            <label for="client_id" data-i18n="setup_step1_client_id">Client ID</label>
            <input type="text" id="client_id" name="client_id" value="<%= credentials.client_id || '' %>" placeholder="Paste your Spotify Client ID">
          </div>
          <div class="form-group">
            <label for="client_secret" data-i18n="setup_step1_client_secret">Client Secret</label>
            <input type="password" id="client_secret" name="client_secret" value="<%= credentials.client_id ? '••••••••' : '' %>" autocomplete="new-password" placeholder="Paste your Spotify Client Secret">
            <% if (credentials.client_id) { %><p class="field-hint">Leave blank to keep existing value.</p><% } %>
          </div>
          <div class="form-group">
            <label data-i18n="setup_step1_redirect">Redirect URI</label>
            <div class="copy-block">
              <input type="text" value="<%= isLanHttp ? loopbackRedirectUri : redirectUri %>" readonly id="redir-copy">
              <button type="button" class="btn-copy" onclick="copyRedirect()">Copy</button>
            </div>
            <p class="field-hint" data-i18n="setup_step1_redirect_hint">
              Copy this value exactly into your Spotify Dashboard → Redirect URIs.
              Use <strong>127.0.0.1</strong>, not <code>localhost</code> — Spotify blocks <code>localhost</code> since Nov 2025.
            </p>
          </div>
        </div><!-- /oauth-fields -->

        <!-- Cookie fields -->
        <div id="cookie-fields" style="display:<%= isCookieMode ? 'block' : 'none' %>">
          <div style="background:rgba(15,98,254,.06);border:1px solid rgba(15,98,254,.25);border-radius:6px;padding:.9rem 1rem;margin-bottom:1rem;font-size:.88rem;line-height:1.6">
            <strong style="display:block;margin-bottom:.4rem" data-i18n="setup_cookie_howto_title">How to get your sp_dc cookie:</strong>
            <ol style="margin:0;padding-left:1.2rem">
              <li data-i18n="setup_cookie_step1">Open <a href="https://open.spotify.com" target="_blank" rel="noopener">open.spotify.com</a> in your browser and sign in.</li>
              <li data-i18n="setup_cookie_step2">Open DevTools: <kbd>F12</kbd> → <strong>Application</strong> tab (Chrome) or <strong>Storage</strong> (Firefox).</li>
              <li data-i18n="setup_cookie_step3">Navigate to <strong>Cookies → https://open.spotify.com</strong></li>
              <li data-i18n="setup_cookie_step4">Copy the value of the cookie named <code>sp_dc</code>.</li>
              <li data-i18n="setup_cookie_step5">Paste it below.</li>
            </ol>
          </div>
          <div class="form-group">
            <label for="sp_dc" data-i18n="setup_cookie_field_label">sp_dc Cookie</label>
            <input type="password" id="sp_dc" name="sp_dc" autocomplete="off"
              value="<%= config.spotify && config.spotify.sp_dc ? '••••••••' : '' %>"
              placeholder="AQB3...">
            <% if (config.spotify && config.spotify.sp_dc) { %>
            <p class="field-hint" data-i18n="setup_cookie_keep_hint">Leave blank to keep existing cookie.</p>
            <% } %>
          </div>
        </div><!-- /cookie-fields -->

        <!-- Cookie-Mode Diagnose-Panel -->
        <div id="cookie-test-panel" style="display:<%= isCookieMode ? 'block' : 'none' %>;margin-top:1rem">
          <button type="button" id="cookie-test-btn" class="btn" style="background:rgba(15,98,254,.12);border:1px solid #0f62fe;color:#0f62fe;font-size:.85rem;padding:.4rem 1rem" onclick="runCookieTest()">
            🔍 Verbindung testen
          </button>
          <div id="cookie-test-output" style="display:none;margin-top:.75rem;background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:.75rem 1rem;font-family:monospace;font-size:.8rem;line-height:1.6;white-space:pre-wrap;max-height:260px;overflow-y:auto"></div>
        </div>

        <div class="btn-row">
          <button type="submit" class="btn btn-primary" data-i18n="setup_step1_next">Next</button>
        </div>
      </form>
    </div>

    <!-- Step 2: Spotify OAuth -->
    <div class="step-panel <%= step === 2 ? 'active' : '' %>">
      <h2 data-i18n="setup_step2_title">Step 2: Connect your Spotify account</h2>
      <p style="color:var(--text-muted);margin:0.75rem 0 1.5rem;font-size:.9rem" data-i18n="setup_step2_desc">
        Now we'll connect Daily Drive to your Spotify account. You'll be briefly redirected to Spotify.
      </p>

      <% if (isLanHttp) { %>
        <!-- NAS Copy-Paste Flow UI -->
        <div class="nas-flow-card" style="border: 1px solid var(--border); padding: 1.25rem; border-radius: 8px; background: rgba(15, 98, 254, 0.05); margin-bottom: 1.5rem;">
          <h3 style="margin-top:0; font-size: 1rem; color: #0f62fe; display: flex; align-items: center; gap: 0.5rem;" data-i18n="setup_nas_mode_title">
            🔗 Loopback Copy-Paste (NAS Mode)
          </h3>
          <p style="font-size: 0.85rem; line-height: 1.4; color: var(--text-muted); margin-bottom: 1rem;" data-i18n="setup_nas_mode_desc">
            Since your NAS is accessed via HTTP, we will authorize using a loopback IP. Follow these steps:
          </p>
          <ol style="font-size: 0.85rem; color: var(--text); padding-left: 1.25rem; margin-bottom: 1.25rem; line-height: 1.5;">
            <li>
              <span data-i18n="setup_nas_step1">Ensure <code><%= loopbackRedirectUri %></code> is registered in Spotify.</span>
            </li>
            <li>
              <span data-i18n="setup_nas_step2">Click the authorize button below. You will be redirected to Spotify.</span>
            </li>
            <li>
              <span data-i18n="setup_nas_step3">After agreeing, your browser will land on a <strong>failed/blank page</strong> (e.g. <code>Site can't be reached</code>).</span>
            </li>
            <li>
              <span data-i18n="setup_nas_step4"><strong>Copy the entire failed URL</strong> from your browser's address bar.</span>
            </li>
            <li>
              <span data-i18n="setup_nas_step5">Return here and paste it below to complete the connection!</span>
            </li>
          </ol>

          <div style="margin-bottom: 1.25rem;">
            <a href="/setup/authorize?use_loopback=true" target="_blank" class="btn btn-spotify" style="font-size:0.9rem;padding:.5rem 1.25rem; display: inline-block;">
              🎵 <span data-i18n="setup_nas_authorize_btn">Open Spotify Authorization</span>
            </a>
          </div>

          <form action="/setup/callback-paste" method="POST" style="margin-top: 1rem;">
            <div class="form-group" style="margin-bottom: 0.75rem;">
              <label for="callback_url" style="font-size: 0.8rem; font-weight: 600;" data-i18n="setup_nas_input_label">Pasted Redirect URL</label>
              <input type="text" id="callback_url" name="callback_url" required placeholder="http://127.0.0.1:<%= new URL(loopbackRedirectUri).port || '8080' %>/callback?code=..." style="width: 100%;">
            </div>
            <button type="submit" class="btn btn-primary" style="font-size: 0.85rem; padding: 0.5rem 1rem;" data-i18n="setup_nas_submit_btn">Complete Connection</button>
          </form>
        </div>
      <% } else { %>
        <div class="btn-row">
          <a href="/setup?step=1" class="btn btn-ghost" data-i18n="setup_step2_back">Back</a>
          <a href="/setup/authorize" class="btn btn-spotify" style="font-size:1rem;padding:.75rem 2rem">
            🎵 <span data-i18n="setup_step2_authorize">Authorize with Spotify</span>
          </a>
        </div>
      <% } %>

      <% if (isLanHttp) { %>
        <div class="btn-row" style="margin-top: 1rem; border-top: 1px solid var(--border); padding-top: 1rem;">
          <a href="/setup?step=1" class="btn btn-ghost" data-i18n="setup_step2_back">Back</a>
        </div>
      <% } %>
    </div>

    <!-- Step 3: Playlist -->
    <div class="step-panel <%= step === 3 ? 'active' : '' %>">
      <h2 data-i18n="setup_step3_title">Step 3: Playlist</h2>

      <form action="/setup/playlist" method="POST">
        <input type="hidden" name="api_mode" value="<%= config.api_mode || 'oauth' %>">
        <!-- Hidden field carries the ID to the server -->
        <input type="hidden" id="playlist_url" name="playlist_url" value="<%= config.playlist_id || '' %>">

        <!-- Card showing current selection -->
        <div id="setup-playlist-card" style="display:<%= config.playlist_id ? 'flex' : 'none' %>;align-items:center;gap:.75rem;padding:.6rem .75rem;background:var(--bg2,#262626);border:1px solid var(--border);border-radius:6px;margin-bottom:.75rem">
          <img id="setup-playlist-img" src="" alt="" style="width:40px;height:40px;border-radius:4px;object-fit:cover;display:none">
          <div style="flex:1;min-width:0">
            <div id="setup-playlist-name" style="font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= config.playlist_id || '' %></div>
          </div>
          <button type="button" class="btn-remove" onclick="clearSetupPlaylist()" title="Remove">✕</button>
        </div>
        <div id="setup-playlist-empty" style="display:<%= config.playlist_id ? 'none' : 'block' %>;color:var(--text-muted);font-size:.875rem;margin-bottom:.75rem" data-i18n="dash_playlist_empty">No playlist selected.</div>

        <p id="create-playlist-status" style="font-size:.85rem;margin-top:.35rem;display:none"></p>

        <div class="btn-row" style="margin-top:0">
          <button type="button" class="btn btn-primary" onclick="openSetupPicker()" data-i18n="picker_select_playlist">🔍 Select from Spotify</button>
          <button type="button" class="btn btn-ghost" id="create-playlist-btn"
            onclick="createPlaylist()" data-i18n="setup_step3_create_btn">
            + Create new
          </button>
        </div>

        <div class="btn-row" style="margin-top:1rem">
          <a href="/setup?step=<%= isCookieMode ? 1 : 2 %>" class="btn btn-ghost" data-i18n="setup_step3_back">Back</a>
          <button type="submit" class="btn btn-primary" data-i18n="setup_step3_next">Next →</button>
        </div>
      </form>

      <!-- Playlist picker modal (inline for setup wizard) -->
      <div id="setup-picker" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:1000;overflow-y:auto">
        <div style="background:var(--surface,#161616);border:1px solid var(--border,#393939);border-radius:8px;max-width:520px;margin:4rem auto;padding:1.5rem">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
            <strong data-i18n="picker_select_playlist">Select playlist</strong>
            <button type="button" onclick="closeSetupPicker()" style="background:none;border:none;color:inherit;font-size:1.25rem;cursor:pointer">&times;</button>
          </div>
          <div id="setup-picker-loading" style="text-align:center;padding:1rem;color:var(--text-muted)">Loading…</div>
          <div id="setup-picker-results" class="picker-results-grid"></div>
        </div>
      </div>
    </div>

  </div><!-- /left -->

  <!-- ===== Right: Bob ===== -->
  <div class="wizard-bob">
    <img src="/img/bob/bob-standing-BECrMjXJ.webp" alt="IBM Bob">
    <p class="bob-caption">IBM Bob</p>
  </div>
</div><!-- /wizard-layout -->

<% } %>

<script>
function onModeChange() {
  const isCookie = document.getElementById('mode-cookie').checked;
  document.getElementById('oauth-fields').style.display = isCookie ? 'none' : 'block';
  document.getElementById('cookie-fields').style.display = isCookie ? 'block' : 'none';
  document.getElementById('cookie-test-panel').style.display = isCookie ? 'block' : 'none';
  // Reset test output when switching modes
  document.getElementById('cookie-test-output').style.display = 'none';
  document.getElementById('cookie-test-output').textContent = '';
}

async function runCookieTest() {
  const btn = document.getElementById('cookie-test-btn');
  const out = document.getElementById('cookie-test-output');
  btn.disabled = true;
  btn.textContent = '⏳ Teste …';
  out.style.display = 'block';
  out.textContent = 'Starte Diagnose …\n';

  // Read sp_dc from the input field — skip placeholder value
  const fieldVal = (document.getElementById('sp_dc') || {}).value || '';
  const spDc = (fieldVal && !fieldVal.startsWith('•')) ? fieldVal.trim() : '';

  try {
    const resp = await fetch('/api/test-cookie-login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sp_dc: spDc }),
    });
    const data = await resp.json();
    out.textContent = data.steps.join('\n');
    if (data.ok) {
      btn.style.background = 'rgba(36,161,72,.15)';
      btn.style.borderColor = '#24a148';
      btn.style.color = '#24a148';
      btn.textContent = '✅ Verbindung erfolgreich';
    } else {
      btn.style.background = 'rgba(218,30,40,.12)';
      btn.style.borderColor = '#da1e28';
      btn.style.color = '#da1e28';
      btn.textContent = '❌ Verbindung fehlgeschlagen';
    }
  } catch (e) {
    out.textContent += '\n❌ Netzwerkfehler: ' + e.message;
    btn.textContent = '❌ Fehler';
  } finally {
    btn.disabled = false;
  }
}

function setSetupPlaylist(id, name, image) {
  document.getElementById('playlist_url').value = id;
  document.getElementById('setup-playlist-name').textContent = name;
  const img = document.getElementById('setup-playlist-img');
  if (image) { img.src = image; img.style.display = 'block'; }
  else { img.style.display = 'none'; }
  document.getElementById('setup-playlist-card').style.display = 'flex';
  document.getElementById('setup-playlist-empty').style.display = 'none';
}

function clearSetupPlaylist() {
  document.getElementById('playlist_url').value = '';
  document.getElementById('setup-playlist-card').style.display = 'none';
  document.getElementById('setup-playlist-empty').style.display = 'block';
}

async function openSetupPicker() {
  document.getElementById('setup-picker').style.display = 'block';
  document.getElementById('setup-picker-loading').style.display = 'block';
  document.getElementById('setup-picker-results').innerHTML = '';
  try {
    const resp = await fetch('/api/user-playlists');
    const items = await resp.json();
    document.getElementById('setup-picker-loading').style.display = 'none';
    const grid = document.getElementById('setup-picker-results');
    if (!items || items.length === 0) {
      grid.innerHTML = '<p style="color:var(--text-muted);text-align:center;padding:1rem">No playlists found.</p>';
      return;
    }
    items.forEach(item => {
      const card = document.createElement('div');
      card.className = 'picker-result-card';
      const imgUrl = item.images && item.images.length > 0 ? item.images[item.images.length - 1].url : null;
      card.onclick = () => {
        setSetupPlaylist(item.id, item.name, imgUrl);
        closeSetupPicker();
      };
      card.innerHTML = `
        <img src="${imgUrl || '/img/bob/bob-standing-BECrMjXJ.webp'}" alt="${item.name}">
        <div class="picker-result-info">
          <div class="picker-result-name">${item.name}</div>
          <div class="picker-result-subtext">${item.owner || ''}</div>
        </div>
        <button type="button" class="btn btn-ghost select-btn">Select</button>
      `;
      grid.appendChild(card);
    });
  } catch(e) {
    document.getElementById('setup-picker-loading').textContent = 'Error: ' + e.message;
  }
}
function closeSetupPicker() {
  document.getElementById('setup-picker').style.display = 'none';
}

// On page load: fetch Spotify name for already-saved playlist ID
(async function() {
  const id = document.getElementById('playlist_url').value;
  if (!id) return;
  try {
    const resp = await fetch('/api/playlist-info/' + encodeURIComponent(id));
    if (!resp.ok) return;
    const data = await resp.json();
    setSetupPlaylist(data.id, data.name, data.image);
  } catch(e) { /* silent */ }
})();

function copyRedirect() {
  const el = document.getElementById('redir-copy');
  el.select();
  navigator.clipboard.writeText(el.value).catch(() => document.execCommand('copy'));
  const btn = el.nextElementSibling;
  btn.textContent = '✓';
  setTimeout(() => btn.textContent = 'Copy', 1500);
}

function extractPlaylistId(value) {
  value = value.trim();
  // Full URL: https://open.spotify.com/playlist/37i9dQZF1DX... or with ?si=...
  const m = value.match(/open\.spotify\.com\/playlist\/([A-Za-z0-9]+)/);
  if (m) return m[1];
  // Spotify URI: spotify:playlist:37i9dQZF1DX...
  const u = value.match(/spotify:playlist:([A-Za-z0-9]+)/);
  if (u) return u[1];
  // Raw ID (alphanumeric, 22 chars typical)
  if (/^[A-Za-z0-9]{10,}$/.test(value)) return value;
  return null;
}

function parsePlaylistInput(value) {
  const id = extractPlaylistId(value);
  const input = document.getElementById('playlist_url');
  if (id && id !== value.trim()) {
    input.value = id;
  }
}

async function createPlaylist() {
  const btn = document.getElementById('create-playlist-btn');
  const status = document.getElementById('create-playlist-status');
  btn.disabled = true;
  btn.textContent = '…';
  status.style.display = 'block';
  status.style.color = 'var(--text-muted)';
  status.textContent = 'Creating playlist…';

  try {
    const res = await fetch('/api/create-playlist', { method: 'POST' });
    const data = await res.json();
    if (data.id) {
      setSetupPlaylist(data.id, data.name, null);
      status.style.color = '#22c55e';
      status.textContent = '✓ Playlist "' + data.name + '" created!';
      btn.textContent = '✓ Created';
    } else {
      throw new Error(data.error || 'Unknown error');
    }
  } catch (e) {
    status.style.color = '#ef4444';
    status.textContent = '✗ ' + e.message;
    btn.disabled = false;
    btn.textContent = '+ Create new';
  }
}
</script>
